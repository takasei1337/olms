generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                                         String                  @db.VarChar(50)
  passwordHash                                     String                  @map("password_hash") @db.VarChar(255)
  fullName                                         String                  @map("full_name") @db.VarChar(150)
  email                                            String?                 @db.VarChar(150)
  phone                                            String?                 @db.VarChar(20)
  role                                             UserRole                @default(STUDENT)
  status                                           String                  @default("ACTIVE") @db.VarChar(20)
  lastLoginAt                                      DateTime?               @map("last_login_at") @db.Timestamptz(6)
  createdAt                                        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                        DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                                        DateTime?               @map("deleted_at") @db.Timestamptz(6)
  deletedBy                                        String?                 @map("deleted_by") @db.Uuid
  answer_options                                   AnswerOption[]
  audit_logs                                       AuditLog[]
  chapters                                         Chapter[]
  detected_answers                                 DetectedAnswer[]
  exam_grading_rules                               ExamGradingRule[]
  exam_matrices                                    ExamMatrix[]
  exam_variants                                    ExamVariant[]
  exams_exams_created_byTousers                    Exam[]                  @relation("exams_created_byTousers")
  exams_exams_deleted_byTousers                    Exam[]                  @relation("exams_deleted_byTousers")
  exams_exams_result_published_byTousers           Exam[]                  @relation("exams_result_published_byTousers")
  form_templates                                   FormTemplate[]
  grades                                           Grade[]
  lessons                                          Lesson[]
  participants_participants_deleted_byTousers      Participant[]           @relation("participants_deleted_byTousers")
  participants_participants_student_user_idTousers Participant[]           @relation("participants_student_user_idTousers")
  question_types                                   QuestionType[]
  question_versions                                QuestionVersion[]
  questions_questions_created_byTousers            Question[]              @relation("questions_created_byTousers")
  questions_questions_deleted_byTousers            Question[]              @relation("questions_deleted_byTousers")
  refreshTokens                                    RefreshToken[]
  scan_images                                      ScanImage[]
  student_profiles                                 StudentProfile[]
  subjects_subjects_created_byTousers              Subject[]               @relation("subjects_created_byTousers")
  subjects_subjects_deleted_byTousers              Subject[]               @relation("subjects_deleted_byTousers")
  submission_answer_grades                         SubmissionAnswerGrade[]
  users                                            User?                   @relation("usersTousers", fields: [deletedBy], references: [id], onUpdate: NoAction, map: "fk_users_deleted_by")
  other_users                                      User[]                  @relation("usersTousers")

  @@index([deletedBy], map: "idx_users_deleted_by")
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@map("refresh_tokens")
}

model StudentProfile {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentCode  String        @unique(map: "uq_student_profiles_code") @map("student_code") @db.VarChar(30)
  fullName     String        @map("full_name") @db.VarChar(150)
  email        String?       @db.VarChar(150)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?       @map("deleted_by") @db.Uuid
  participants Participant[]
  users        User?         @relation(fields: [deletedBy], references: [id], onUpdate: NoAction, map: "fk_student_profiles_deleted_by")

  @@index([deletedBy], map: "idx_student_profiles_deleted_by")
  @@map("student_profiles")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(50)
  entityName  String   @map("entity_name") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.Uuid
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  users       User?    @relation(fields: [actorUserId], references: [id], onUpdate: NoAction, map: "fk_audit_logs_actor_user_id")

  @@index([actorUserId], map: "idx_audit_logs_actor_user_id")
  @@map("audit_logs")
}

model Subject {
  id                               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                             String    @db.VarChar(20)
  name                             String    @db.VarChar(150)
  description                      String?
  createdBy                        String?   @map("created_by") @db.Uuid
  createdAt                        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                        DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy                        String?   @map("deleted_by") @db.Uuid
  chapters                         Chapter[]
  exams                            Exam[]
  users_subjects_created_byTousers User?     @relation("subjects_created_byTousers", fields: [createdBy], references: [id], onUpdate: NoAction, map: "fk_subjects_created_by")
  users_subjects_deleted_byTousers User?     @relation("subjects_deleted_byTousers", fields: [deletedBy], references: [id], onUpdate: NoAction, map: "fk_subjects_deleted_by")

  @@index([createdBy], map: "idx_subjects_created_by")
  @@index([deletedBy], map: "idx_subjects_deleted_by")
  @@map("subjects")
}

model Chapter {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId     String       @map("subject_id") @db.Uuid
  code          String?      @db.VarChar(20)
  name          String       @db.VarChar(150)
  orderNo       Int          @default(0) @map("order_no") @db.SmallInt
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  deletedBy     String?      @map("deleted_by") @db.Uuid
  users         User?        @relation(fields: [deletedBy], references: [id], onUpdate: NoAction, map: "fk_chapters_deleted_by")
  subject       Subject      @relation(fields: [subjectId], references: [id], onUpdate: NoAction, map: "fk_chapters_subject_id")
  exam_matrices ExamMatrix[]
  lessons       Lesson[]

  @@index([deletedBy], map: "idx_chapters_deleted_by")
  @@index([subjectId], map: "idx_chapters_subject_id")
  @@map("chapters")
}

model Lesson {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chapterId     String       @map("chapter_id") @db.Uuid
  code          String?      @db.VarChar(20)
  name          String       @db.VarChar(150)
  orderNo       Int          @default(0) @map("order_no") @db.SmallInt
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  deletedBy     String?      @map("deleted_by") @db.Uuid
  exam_matrices ExamMatrix[]
  chapter       Chapter      @relation(fields: [chapterId], references: [id], onUpdate: NoAction, map: "fk_lessons_chapter_id")
  users         User?        @relation(fields: [deletedBy], references: [id], onUpdate: NoAction, map: "fk_lessons_deleted_by")
  questions     Question[]

  @@index([chapterId], map: "idx_lessons_chapter_id")
  @@index([deletedBy], map: "idx_lessons_deleted_by")
  @@map("lessons")
}

model QuestionType {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String            @db.VarChar(30)
  name               String            @db.VarChar(100)
  description        String?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz(6)
  deletedBy          String?           @map("deleted_by") @db.Uuid
  exam_grading_rules ExamGradingRule[]
  exam_matrices      ExamMatrix[]
  users              User?             @relation(fields: [deletedBy], references: [id], onUpdate: NoAction, map: "fk_question_types_deleted_by")
  question_versions  QuestionVersion[]
  questions          Question[]

  @@index([deletedBy], map: "idx_question_types_deleted_by")
  @@map("question_types")
}

model Question {
  id                                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId                          String?           @map("lesson_id") @db.Uuid
  typeId                            String            @map("type_id") @db.Uuid
  status                            String            @default("DRAFT") @db.VarChar(20)
  aiSimilarityScore                 Decimal?          @map("ai_similarity_score") @db.Decimal(5, 4)
  aiCheckStatus                     String            @default("PENDING") @map("ai_check_status") @db.VarChar(20)
  isDuplicateOverridden             Boolean           @default(false) @map("is_duplicate_overridden")
  aiAuditMetadata                   Json?             @map("ai_audit_metadata")
  createdBy                         String?           @map("created_by") @db.Uuid
  createdAt                         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                         DateTime?         @map("deleted_at") @db.Timestamptz(6)
  deletedBy                         String?           @map("deleted_by") @db.Uuid
  topicTag                          String?           @map("topic_tag") @db.VarChar(100)
  options                           AnswerOption[]
  versions                          QuestionVersion[]
  users_questions_created_byTousers User?             @relation("questions_created_byTousers", fields: [createdBy], references: [id], onUpdate: NoAction, map: "fk_questions_created_by")
  users_questions_deleted_byTousers User?             @relation("questions_deleted_byTousers", fields: [deletedBy], references: [id], onUpdate: NoAction, map: "fk_questions_deleted_by")
  lesson                            Lesson?           @relation(fields: [lessonId], references: [id], onUpdate: NoAction, map: "fk_questions_lesson_id")
  type                              QuestionType      @relation(fields: [typeId], references: [id], onUpdate: NoAction, map: "fk_questions_type_id")

  @@index([createdBy], map: "idx_questions_created_by")
  @@index([deletedBy], map: "idx_questions_deleted_by")
  @@index([lessonId], map: "idx_questions_lesson_id")
  @@index([typeId], map: "idx_questions_type_id")
  @@map("questions")
}

model QuestionVersion {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId       String                @map("question_id") @db.Uuid
  versionNo        Int                   @map("version_no")
  typeId           String                @map("type_id") @db.Uuid
  difficultyLevel  DifficultyLevel       @map("difficulty_level")
  content          String
  mediaUrl         String?               @map("media_url") @db.VarChar(500)
  explanation      String?
  optionsSnapshot  Json                  @map("options_snapshot")
  isCurrent        Boolean               @default(true) @map("is_current")
  frozenAt         DateTime?             @map("frozen_at") @db.Timestamptz(6)
  createdBy        String?               @map("created_by") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  variantQuestions ExamVariantQuestion[]
  users            User?                 @relation(fields: [createdBy], references: [id], onUpdate: NoAction, map: "fk_question_versions_created_by")
  question         Question              @relation(fields: [questionId], references: [id], onUpdate: NoAction, map: "fk_question_versions_question_id")
  question_types   QuestionType          @relation(fields: [typeId], references: [id], onUpdate: NoAction, map: "fk_question_versions_type_id")

  @@unique([questionId, versionNo], map: "uq_question_versions_question_version")
  @@index([createdBy], map: "idx_question_versions_created_by")
  @@index([questionId], map: "idx_question_versions_question_id")
  @@index([typeId], map: "idx_question_versions_type_id")
  @@map("question_versions")
}

model AnswerOption {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String    @map("question_id") @db.Uuid
  content    String
  isCorrect  Boolean   @default(false) @map("is_correct")
  matchKey   String?   @map("match_key") @db.VarChar(50)
  orderNo    Int       @default(0) @map("order_no") @db.SmallInt
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy  String?   @map("deleted_by") @db.Uuid
  users      User?     @relation(fields: [deletedBy], references: [id], onUpdate: NoAction, map: "fk_answer_options_deleted_by")
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_answer_options_question_id")

  @@index([deletedBy], map: "idx_answer_options_deleted_by")
  @@index([questionId], map: "idx_answer_options_question_id")
  @@map("answer_options")
}

model FormTemplate {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String    @db.VarChar(50)
  version      String    @default("1.0") @db.VarChar(20)
  name         String    @db.VarChar(150)
  numQuestions Int       @map("num_questions") @db.SmallInt
  isActive     Boolean   @default(true) @map("is_active")
  layoutConfig Json      @map("layout_config")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?   @map("deleted_by") @db.Uuid
  exams        Exam[]
  users        User?     @relation(fields: [deletedBy], references: [id], onUpdate: NoAction, map: "fk_form_templates_deleted_by")

  @@index([deletedBy], map: "idx_form_templates_deleted_by")
  @@map("form_templates")
}

model Exam {
  id                                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                                   String            @db.VarChar(30)
  name                                   String            @db.VarChar(200)
  subjectId                              String            @map("subject_id") @db.Uuid
  formTemplateId                         String?           @map("form_template_id") @db.Uuid
  status                                 String            @default("DRAFT") @db.VarChar(20)
  deliveryMode                           String            @default("ONLINE") @map("delivery_mode") @db.VarChar(20)
  totalQuestions                         Int               @map("total_questions") @db.SmallInt
  durationMinutes                        Int               @map("duration_minutes") @db.SmallInt
  opensAt                                DateTime          @map("opens_at") @db.Timestamptz(6)
  closesAt                               DateTime          @map("closes_at") @db.Timestamptz(6)
  totalScore                             Decimal           @default(10) @map("total_score") @db.Decimal(5, 2)
  resultVisibilityMode                   String            @default("HIDDEN") @map("result_visibility_mode") @db.VarChar(20)
  resultPublishedAt                      DateTime?         @map("result_published_at") @db.Timestamptz(6)
  resultPublishedBy                      String?           @map("result_published_by") @db.Uuid
  createdBy                              String?           @map("created_by") @db.Uuid
  createdAt                              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                              DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                              DateTime?         @map("deleted_at") @db.Timestamptz(6)
  deletedBy                              String?           @map("deleted_by") @db.Uuid
  gradingRules                           ExamGradingRule[]
  matrices                               ExamMatrix[]
  variants                               ExamVariant[]
  users_exams_created_byTousers          User?             @relation("exams_created_byTousers", fields: [createdBy], references: [id], onUpdate: NoAction, map: "fk_exams_created_by")
  users_exams_deleted_byTousers          User?             @relation("exams_deleted_byTousers", fields: [deletedBy], references: [id], onUpdate: NoAction, map: "fk_exams_deleted_by")
  formTemplate                           FormTemplate?     @relation(fields: [formTemplateId], references: [id], onUpdate: NoAction, map: "fk_exams_form_template_id")
  users_exams_result_published_byTousers User?             @relation("exams_result_published_byTousers", fields: [resultPublishedBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_exams_result_published_by")
  subject                                Subject           @relation(fields: [subjectId], references: [id], onUpdate: NoAction, map: "fk_exams_subject_id")
  participants                           Participant[]
  scan_images                            ScanImage[]

  @@index([createdBy], map: "idx_exams_created_by")
  @@index([deletedBy], map: "idx_exams_deleted_by")
  @@index([formTemplateId], map: "idx_exams_form_template_id")
  @@index([resultPublishedBy], map: "idx_exams_result_published_by")
  @@index([subjectId], map: "idx_exams_subject_id")
  @@map("exams")
}

model ExamMatrix {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId               String          @map("exam_id") @db.Uuid
  chapterId            String?         @map("chapter_id") @db.Uuid
  lessonId             String?         @map("lesson_id") @db.Uuid
  questionTypeId       String          @map("question_type_id") @db.Uuid
  difficultyLevel      DifficultyLevel @map("difficulty_level")
  numQuestions         Int             @map("num_questions") @db.SmallInt
  scorePerQuestion     Decimal         @default(0) @map("score_per_question") @db.Decimal(5, 2)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?       @map("deleted_at") @db.Timestamptz(6)
  deletedBy            String?         @map("deleted_by") @db.Uuid
  maxQuestionsPerTopic Int?            @default(2) @map("max_questions_per_topic") @db.SmallInt
  chapters             Chapter?        @relation(fields: [chapterId], references: [id], onUpdate: NoAction, map: "fk_exam_matrices_chapter_id")
  users                User?           @relation(fields: [deletedBy], references: [id], onUpdate: NoAction, map: "fk_exam_matrices_deleted_by")
  exam                 Exam            @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_exam_matrices_exam_id")
  lessons              Lesson?         @relation(fields: [lessonId], references: [id], onUpdate: NoAction, map: "fk_exam_matrices_lesson_id")
  question_types       QuestionType    @relation(fields: [questionTypeId], references: [id], onUpdate: NoAction, map: "fk_exam_matrices_question_type_id")

  @@index([chapterId], map: "idx_exam_matrices_chapter_id")
  @@index([deletedBy], map: "idx_exam_matrices_deleted_by")
  @@index([examId], map: "idx_exam_matrices_exam_id")
  @@index([lessonId], map: "idx_exam_matrices_lesson_id")
  @@index([questionTypeId], map: "idx_exam_matrices_question_type_id")
  @@map("exam_matrices")
}

model ExamGradingRule {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId               String       @map("exam_id") @db.Uuid
  questionTypeId       String       @map("question_type_id") @db.Uuid
  scoringMode          String       @default("EXACT_MATCH") @map("scoring_mode") @db.VarChar(20)
  allowNegativeMarking Boolean      @default(false) @map("allow_negative_marking")
  penaltyForWrong      Boolean      @default(true) @map("penalty_for_wrong")
  caseSensitive        Boolean      @default(false) @map("case_sensitive")
  roundingPrecision    Int          @default(2) @map("rounding_precision") @db.SmallInt
  roundingRule         String       @default("ROUND_HALF_UP") @map("rounding_rule") @db.VarChar(20)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?    @map("deleted_at") @db.Timestamptz(6)
  deletedBy            String?      @map("deleted_by") @db.Uuid
  users                User?        @relation(fields: [deletedBy], references: [id], onUpdate: NoAction, map: "fk_egr_deleted_by")
  exam                 Exam         @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_egr_exam_id")
  question_types       QuestionType @relation(fields: [questionTypeId], references: [id], onUpdate: NoAction, map: "fk_egr_question_type_id")

  @@index([deletedBy], map: "idx_egr_deleted_by")
  @@index([examId], map: "idx_egr_exam_id")
  @@index([questionTypeId], map: "idx_egr_question_type_id")
  @@map("exam_grading_rules")
}

model ExamVariant {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId       String                @map("exam_id") @db.Uuid
  variantCode  String                @map("variant_code") @db.VarChar(10)
  isRoot       Boolean               @default(false) @map("is_root")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?             @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?               @map("deleted_by") @db.Uuid
  questions    ExamVariantQuestion[]
  users        User?                 @relation(fields: [deletedBy], references: [id], onUpdate: NoAction, map: "fk_exam_variants_deleted_by")
  exam         Exam                  @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_exam_variants_exam_id")
  participants Participant[]
  submissions  Submission[]

  @@unique([examId, variantCode], map: "uq_exam_variants_exam_code")
  @@unique([id, examId], map: "uq_exam_variants_id_exam")
  @@index([deletedBy], map: "idx_exam_variants_deleted_by")
  @@index([examId], map: "idx_exam_variants_exam_id")
  @@map("exam_variants")
}

model ExamVariantQuestion {
  id                       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId                String                  @map("variant_id") @db.Uuid
  questionVersionId        String                  @map("question_version_id") @db.Uuid
  positionInVariant        Int                     @map("position_in_variant") @db.SmallInt
  optionOrder              Json                    @map("option_order")
  score                    Decimal                 @default(0) @db.Decimal(5, 2)
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  questionVersion          QuestionVersion         @relation(fields: [questionVersionId], references: [id], onUpdate: NoAction, map: "fk_evq_question_version_id")
  variant                  ExamVariant             @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_evq_variant_id")
  studentAnswers           StudentAnswer[]
  submission_answer_grades SubmissionAnswerGrade[]

  @@unique([variantId, positionInVariant], map: "uq_evq_variant_position")
  @@unique([variantId, questionVersionId], map: "uq_evq_variant_question")
  @@index([questionVersionId], map: "idx_evq_question_version_id")
  @@index([variantId], map: "idx_evq_variant_id")
  @@map("exam_variant_questions")
}

model Participant {
  id                                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId                                    String         @map("exam_id") @db.Uuid
  studentUserId                             String         @map("student_user_id") @db.Uuid
  studentProfileId                          String         @map("student_profile_id") @db.Uuid
  studentCode                               String         @map("student_code") @db.VarChar(30)
  fullNameSnapshot                          String         @map("full_name_snapshot") @db.VarChar(150)
  variantId                                 String?        @map("variant_id") @db.Uuid
  seatNo                                    String?        @map("seat_no") @db.VarChar(10)
  status                                    String         @default("REGISTERED") @db.VarChar(20)
  attendanceStatus                          String         @default("NOT_MARKED") @map("attendance_status") @db.VarChar(20)
  createdAt                                 DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                 DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                                 DateTime?      @map("deleted_at") @db.Timestamptz(6)
  deletedBy                                 String?        @map("deleted_by") @db.Uuid
  users_participants_deleted_byTousers      User?          @relation("participants_deleted_byTousers", fields: [deletedBy], references: [id], onUpdate: NoAction, map: "fk_participants_deleted_by")
  exam                                      Exam           @relation(fields: [examId], references: [id], onUpdate: NoAction, map: "fk_participants_exam_id")
  studentProfile                            StudentProfile @relation(fields: [studentProfileId], references: [id], onUpdate: NoAction, map: "fk_participants_student_profile_id")
  users_participants_student_user_idTousers User           @relation("participants_student_user_idTousers", fields: [studentUserId], references: [id], onUpdate: NoAction, map: "fk_participants_student_user_id")
  exam_variants                             ExamVariant?   @relation(fields: [variantId, examId], references: [id, examId], onUpdate: NoAction, map: "fk_participants_variant_exam")
  submissions                               Submission?

  @@unique([examId, studentCode], map: "uq_participants_exam_code")
  @@unique([examId, studentProfileId], map: "uq_participants_exam_profile")
  @@unique([examId, studentUserId], map: "uq_participants_exam_student_user")
  @@unique([id, examId], map: "uq_participants_id_exam")
  @@index([deletedBy], map: "idx_participants_deleted_by")
  @@index([examId], map: "idx_participants_exam_id")
  @@index([studentCode], map: "idx_participants_student_code")
  @@index([studentProfileId], map: "idx_participants_student_profile_id")
  @@index([studentUserId], map: "idx_participants_student_user_id")
  @@index([variantId, examId], map: "idx_participants_variant_exam")
  @@index([variantId], map: "idx_participants_variant_id")
  @@map("participants")
}

model Submission {
  id                                                         String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantId                                              String                  @unique(map: "uq_submissions_participant") @map("participant_id") @db.Uuid
  examId                                                     String                  @map("exam_id") @db.Uuid
  variantId                                                  String?                 @map("variant_id") @db.Uuid
  source                                                     String                  @default("ONLINE") @db.VarChar(10)
  startedAt                                                  DateTime                @default(now()) @map("started_at") @db.Timestamptz(6)
  submittedAt                                                DateTime?               @map("submitted_at") @db.Timestamptz(6)
  status                                                     String                  @default("IN_PROGRESS") @db.VarChar(20)
  rawScore                                                   Decimal?                @map("raw_score") @db.Decimal(5, 2)
  createdAt                                                  DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                  DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  submitToken                                                String?                 @map("submit_token") @db.Uuid
  detectedAnswers                                            DetectedAnswer[]
  grade                                                      Grade?
  scan_images_scan_images_submission_id_exam_idTosubmissions ScanImage[]             @relation("scan_images_submission_id_exam_idTosubmissions")
  scanImages                                                 ScanImage[]
  studentAnswers                                             StudentAnswer[]
  answerGrades                                               SubmissionAnswerGrade[]
  participants                                               Participant             @relation(fields: [participantId, examId], references: [id, examId], onUpdate: NoAction, map: "fk_submissions_participant_exam")
  exam_variants                                              ExamVariant?            @relation(fields: [variantId, examId], references: [id, examId], onUpdate: NoAction, map: "fk_submissions_variant_exam")

  @@unique([id, examId], map: "uq_submissions_id_exam")
  @@unique([participantId, examId], map: "uq_submissions_participant_exam")
  @@index([examId], map: "idx_submissions_exam_id")
  @@index([participantId], map: "idx_submissions_participant_id")
  @@index([variantId], map: "idx_submissions_variant_id")
  @@map("submissions")
}

model StudentAnswer {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId          String              @map("submission_id") @db.Uuid
  examVariantQuestionId String              @map("exam_variant_question_id") @db.Uuid
  clientSequence        BigInt              @default(0) @map("client_sequence")
  lastEditToken         String?             @map("last_edit_token") @db.Uuid
  selectedOptions       Json?               @map("selected_options")
  answerText            String?             @map("answer_text")
  responseData          Json?               @map("response_data")
  gradingStatus         String              @default("UNGRADED") @map("grading_status") @db.VarChar(20)
  score                 Decimal             @default(0) @db.Decimal(5, 2)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  variantQuestion       ExamVariantQuestion @relation(fields: [examVariantQuestionId], references: [id], onUpdate: NoAction, map: "fk_student_answers_evq_id")
  submission            Submission          @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_student_answers_submission_id")

  @@unique([submissionId, examVariantQuestionId], map: "uq_student_answers_sub_evq")
  @@index([examVariantQuestionId], map: "idx_student_answers_evq_id")
  @@index([submissionId], map: "idx_student_answers_submission_id")
  @@map("student_answers")
}

model SubmissionAnswerGrade {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId           String              @map("submission_id") @db.Uuid
  examVariantQuestionId  String              @map("exam_variant_question_id") @db.Uuid
  answerSnapshot         Json?               @map("answer_snapshot")
  correctAnswerSnapshot  Json                @map("correct_answer_snapshot")
  gradingRuleSnapshot    Json?               @map("grading_rule_snapshot")
  gradingStatus          String              @default("UNGRADED") @map("grading_status") @db.VarChar(20)
  maxScore               Decimal             @map("max_score") @db.Decimal(5, 2)
  earnedScore            Decimal             @map("earned_score") @db.Decimal(5, 2)
  gradingDetails         Json?               @map("grading_details")
  iteration              Int                 @default(1) @db.SmallInt
  isFinal                Boolean             @default(true) @map("is_final")
  gradedBy               String?             @map("graded_by") @db.Uuid
  gradedAt               DateTime            @default(now()) @map("graded_at") @db.Timestamptz(6)
  exam_variant_questions ExamVariantQuestion @relation(fields: [examVariantQuestionId], references: [id], onUpdate: NoAction, map: "fk_sag_evq_id")
  users                  User?               @relation(fields: [gradedBy], references: [id], onUpdate: NoAction, map: "fk_sag_graded_by")
  submission             Submission          @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sag_submission_id")

  @@unique([submissionId, examVariantQuestionId, iteration], map: "uq_sag_sub_evq_iteration")
  @@index([examVariantQuestionId], map: "idx_sag_evq_id")
  @@index([gradedBy], map: "idx_sag_graded_by")
  @@index([submissionId], map: "idx_sag_submission_id")
  @@map("submission_answer_grades")
}

model ScanImage {
  id                                                         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId                                                     String           @map("exam_id") @db.Uuid
  submissionId                                               String?          @map("submission_id") @db.Uuid
  pageNo                                                     Int              @default(1) @map("page_no") @db.SmallInt
  filePath                                                   String           @map("file_path") @db.VarChar(500)
  checksum                                                   String?          @db.VarChar(64)
  sharpnessScore                                             Decimal?         @map("sharpness_score") @db.Decimal(6, 2)
  uploadedAt                                                 DateTime         @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  createdAt                                                  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  associationStatus                                          String           @default("UNMATCHED") @map("association_status") @db.VarChar(24)
  processingStatus                                           String           @default("QUEUED") @map("processing_status") @db.VarChar(24)
  imageRevision                                              Int              @default(1) @map("image_revision")
  errorCode                                                  String?          @map("error_code") @db.VarChar(50)
  errorDetail                                                String?          @map("error_detail")
  lastAttemptAt                                              DateTime?        @map("last_attempt_at") @db.Timestamptz(6)
  processedAt                                                DateTime?        @map("processed_at") @db.Timestamptz(6)
  retryCount                                                 Int              @default(0) @map("retry_count")
  leaseUntil                                                 DateTime?        @map("lease_until") @db.Timestamptz(6)
  observedStudentCode                                        String?          @map("observed_student_code") @db.VarChar(30)
  observedVariantCode                                        String?          @map("observed_variant_code") @db.VarChar(30)
  recognitionPayload                                         Json?            @map("recognition_payload")
  bindingActor                                               String?          @map("binding_actor") @db.Uuid
  bindingAt                                                  DateTime?        @map("binding_at") @db.Timestamptz(6)
  bindingNote                                                String?          @map("binding_note")
  detected_answers                                           DetectedAnswer[]
  users                                                      User?            @relation(fields: [bindingActor], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_scan_images_binding_actor")
  exams                                                      Exam             @relation(fields: [examId], references: [id], onUpdate: NoAction, map: "fk_scan_images_exam_id")
  submissions_scan_images_submission_id_exam_idTosubmissions Submission?      @relation("scan_images_submission_id_exam_idTosubmissions", fields: [submissionId, examId], references: [id, examId], onUpdate: NoAction, map: "fk_scan_images_submission_exam")
  submission                                                 Submission?      @relation(fields: [submissionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_scan_images_submission_id")

  @@unique([id, submissionId], map: "uq_scan_images_id_submission")
  @@unique([submissionId, pageNo], map: "uq_scan_images_submission_page")
  @@index([examId, associationStatus, processingStatus], map: "idx_scan_images_exam_status")
  @@index([submissionId], map: "idx_scan_images_submission_id")
  @@map("scan_images")
}

model DetectedAnswer {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId      String     @map("submission_id") @db.Uuid
  scanImageId       String     @map("scan_image_id") @db.Uuid
  questionPosition  Int        @map("question_position") @db.SmallInt
  detectedOptions   Json?      @map("detected_options")
  fillScores        Json       @map("fill_scores")
  confidence        Decimal?   @db.Decimal(4, 3)
  detectionStatus   String     @map("detection_status") @db.VarChar(20)
  manuallyCorrected Boolean    @default(false) @map("manually_corrected")
  originalDetection Json?      @map("original_detection")
  correctedOptions  Json?      @map("corrected_options")
  correctedBy       String?    @map("corrected_by") @db.Uuid
  correctedAt       DateTime?  @map("corrected_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  users             User?      @relation(fields: [correctedBy], references: [id], onUpdate: NoAction, map: "fk_detected_answers_corrected_by")
  scan_images       ScanImage  @relation(fields: [scanImageId, submissionId], references: [id, submissionId], onDelete: Cascade, onUpdate: NoAction, map: "fk_detected_answers_scan_submission")
  submission        Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_detected_answers_submission_id")

  @@unique([submissionId, questionPosition], map: "uq_detected_answers_submission_pos")
  @@index([correctedBy], map: "idx_detected_answers_corrected_by")
  @@index([scanImageId, submissionId], map: "idx_detected_answers_scan_submission")
  @@index([detectionStatus], map: "idx_detected_answers_status")
  @@index([submissionId], map: "idx_detected_answers_submission_id")
  @@map("detected_answers")
}

model Grade {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId String     @unique(map: "uq_grades_submission") @map("submission_id") @db.Uuid
  totalScore   Decimal    @map("total_score") @db.Decimal(5, 2)
  correctCount Int        @default(0) @map("correct_count") @db.SmallInt
  wrongCount   Int        @default(0) @map("wrong_count") @db.SmallInt
  blankCount   Int        @default(0) @map("blank_count") @db.SmallInt
  gradedBy     String?    @map("graded_by") @db.Uuid
  gradedAt     DateTime   @default(now()) @map("graded_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  users        User?      @relation(fields: [gradedBy], references: [id], onUpdate: NoAction, map: "fk_grades_graded_by")
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_grades_submission_id")

  @@index([gradedBy], map: "idx_grades_graded_by")
  @@index([submissionId], map: "idx_grades_submission_id")
  @@map("grades")
}

