PORT=3000
NODE_ENV=development

# Supabase / PostgreSQL Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars

# Allowed Frontend Origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# Background Worker & Sweeps (optional)
WORKER_ENABLED=true
AI_RETRY_ENABLED=true
AI_RETRY_INTERVAL_MS=15000
AI_RETRY_BATCH_SIZE=5
AI_RETRY_MAX_ATTEMPTS=5
AI_RETRY_TIMEOUT_MS=5000
DEADLINE_SWEEP_INTERVAL_MS=10000
DEADLINE_SWEEP_BATCH_SIZE=50

# Login Guard & Rate Limiting (optional)
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=60
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MS=900000
LOGIN_LOCKOUT_MS=300000
