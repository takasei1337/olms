{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "version": "1.0.0",
  "name": "OLMS Design System Tokens",
  "description": "3-Layer Design Token Architecture for Online Learning & Examination Management System",

  "primitive": {
    "color": {
      "blue": {
        "50": "#eff6ff",
        "100": "#dbeafe",
        "200": "#bfdbfe",
        "300": "#93c5fd",
        "400": "#60a5fa",
        "500": "#3b82f6",
        "600": "#2563eb",
        "700": "#1d4ed8",
        "800": "#1e40af",
        "900": "#1e3a8a",
        "950": "#172554"
      },
      "slate": {
        "50": "#f8fafc",
        "100": "#f1f5f9",
        "200": "#e2e8f0",
        "300": "#cbd5e1",
        "400": "#94a3b8",
        "500": "#64748b",
        "600": "#475569",
        "700": "#334155",
        "800": "#1e293b",
        "900": "#0f172a",
        "950": "#020617"
      },
      "emerald": {
        "50": "#ecfdf5",
        "100": "#d1fae5",
        "500": "#10b981",
        "600": "#059669",
        "700": "#047857"
      },
      "amber": {
        "50": "#fffbeb",
        "100": "#fef3c7",
        "500": "#f59e0b",
        "600": "#d97706",
        "700": "#b45309"
      },
      "rose": {
        "50": "#fff1f2",
        "100": "#ffe4e6",
        "500": "#f43f5e",
        "600": "#e11d48",
        "700": "#be123c"
      },
      "violet": {
        "50": "#f5f3ff",
        "100": "#ede9fe",
        "500": "#8b5cf6",
        "600": "#7c3aed",
        "700": "#6d28d9"
      }
    },
    "font": {
      "family": {
        "sans": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "mono": "'JetBrains Mono', 'Fira Code', 'Roboto Mono', monospace",
        "math": "'KaTeX_Main', 'Times New Roman', serif"
      },
      "size": {
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem",
        "4xl": "2.25rem"
      },
      "weight": {
        "normal": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      }
    },
    "spacing": {
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem"
    },
    "radius": {
      "none": "0px",
      "sm": "0.25rem",
      "md": "0.375rem",
      "lg": "0.5rem",
      "xl": "0.75rem",
      "full": "9999px"
    },
    "shadow": {
      "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
      "base": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
      "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
      "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
      "exam_focus": "0 0 0 3px rgba(37, 99, 235, 0.2)"
    },
    "transition": {
      "fast": "150ms",
      "normal": "250ms"
    }
  },

  "semantic": {
    "brand": {
      "primary": "{primitive.color.blue.600}",
      "primary_hover": "{primitive.color.blue.700}",
      "primary_light": "{primitive.color.blue.50}",
      "accent": "{primitive.color.violet.600}"
    },
    "surface": {
      "canvas": "{primitive.color.slate.50}",
      "bg_app": "{primitive.color.slate.50}",
      "bg_card": "#ffffff",
      "bg_overlay": "rgba(15, 23, 42, 0.6)",
      "muted": "{primitive.color.slate.100}",
      "border": "{primitive.color.slate.200}",
      "border_focus": "{primitive.color.blue.500}"
    },
    "text": {
      "primary": "{primitive.color.slate.900}",
      "secondary": "{primitive.color.slate.600}",
      "muted": "{primitive.color.slate.400}",
      "tertiary": "{primitive.color.slate.400}",
      "inverted": "#ffffff"
    },
    "status": {
      "success": "{primitive.color.emerald.600}",
      "success_bg": "{primitive.color.emerald.50}",
      "warning": "{primitive.color.amber.600}",
      "warning_bg": "{primitive.color.amber.50}",
      "error": "{primitive.color.rose.600}",
      "error_bg": "{primitive.color.rose.50}",
      "info": "{primitive.color.blue.600}",
      "info_bg": "{primitive.color.blue.50}"
    },
    "examination": {
      "timer": {
        "normal": "{primitive.color.emerald.600}",
        "warning": "{primitive.color.amber.500}",
        "critical": "{primitive.color.rose.600}",
        "danger": "{primitive.color.rose.600}"
      },
      "exam_status": {
        "saved": "{primitive.color.emerald.600}",
        "saving": "{primitive.color.amber.500}",
        "unanswered": "{primitive.color.slate.300}",
        "flagged": "{primitive.color.violet.600}"
      },
      "answer": {
        "unanswered": "{primitive.color.slate.300}",
        "answered": "{primitive.color.blue.600}",
        "flagged": "{primitive.color.violet.600}",
        "confirmed": "{primitive.color.emerald.600}"
      },
      "difficulty": {
        "easy": "{primitive.color.emerald.600}",
        "easy_bg": "{primitive.color.emerald.50}",
        "medium": "{primitive.color.amber.600}",
        "medium_bg": "{primitive.color.amber.50}",
        "hard": "{primitive.color.rose.600}",
        "hard_bg": "{primitive.color.rose.50}"
      },
      "ai_status": {
        "pending": "{primitive.color.slate.500}",
        "checked": "{primitive.color.emerald.600}",
        "duplicate_warning": "{primitive.color.amber.600}",
        "overridden": "{primitive.color.violet.600}",
        "similarity_badge": "{primitive.color.amber.600}",
        "similarity_badge_bg": "{primitive.color.amber.50}",
        "override_notice": "{primitive.color.violet.600}"
      },
      "omr": {
        "valid": "{primitive.color.emerald.600}",
        "ambiguous": "{primitive.color.amber.500}",
        "invalid": "{primitive.color.rose.600}"
      }
    }
  },

  "component": {
    "question_card": {
      "bg": "{semantic.surface.bg_card}",
      "border": "{semantic.surface.border}",
      "radius": "{primitive.radius.lg}",
      "padding": "{primitive.spacing.6}",
      "selected_border": "{semantic.brand.primary}",
      "flagged_border": "{semantic.examination.exam_status.flagged}"
    },
    "exam_timer": {
      "bg": "{semantic.surface.bg_card}",
      "border": "{semantic.surface.border}",
      "padding": "{primitive.spacing.3}",
      "font_family": "{primitive.font.family.mono}",
      "font_size": "{primitive.font.size.xl}",
      "font_weight": "{primitive.font.weight.bold}"
    },
    "matrix_grid": {
      "header_bg": "{primitive.color.slate.100}",
      "cell_padding": "{primitive.spacing.3}",
      "total_highlight": "{primitive.color.blue.50}"
    },
    "omr_viewer": {
      "bubble_size": "24px",
      "ambiguous_glow": "0 0 8px rgba(245, 158, 11, 0.6)"
    }
  }
}
