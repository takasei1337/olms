# Required isolated test database settings. Copy to api-tests/.env to configure.
# Runner and setup refuse to fall back to backend/.env or run against the dev/demo Supabase project.
OLMS_TEST_BASE_URL=http://127.0.0.1:3301/api/v1
OLMS_TEST_AUTO_START=true

OLMS_TEST_SUPABASE_URL=https://your-isolated-test-project.supabase.co
OLMS_TEST_SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key
OLMS_TEST_JWT_ACCESS_SECRET=your-test-jwt-access-secret
OLMS_TEST_JWT_REFRESH_SECRET=your-test-jwt-refresh-secret
OLMS_TEST_DB_CONFIRM=isolated-test-db
